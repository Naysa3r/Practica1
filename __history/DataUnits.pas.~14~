unit DataUnits;

interface

uses
  System.SysUtils;

type

// --- ИСПОЛНИТЕЛИ ---
  PArtist = ^TArtist; // Указатель на запись исполнителя
  TArtist = record
    ArtistCode: Integer;
    Name: string[100];
    Country: string[50];
    Genre: string[30];
    Next: PArtist; // Ссылка на следующего исполнителя в списке
  end;

  // --- АЛЬБОМЫ ---
  PAlbum = ^TAlbum; // Указатель на запись альбома
  TAlbum = record
    AlbumCode: Integer;
    ArtistCode: Integer; // Связь с исполнителем
    Title: string[100];
    Year: Integer;
    Next: PAlbum; // Ссылка на следующий альбом
  end;

  // --- ПЕСНИ ---
  PSong = ^TSong; // Указатель на запись песни
  TSong = record
    Title: string[100];
    AlbumCode: Integer; // Связь с альбомом
    Duration: Integer; // Длительность в секундах
    Next: PSong; // Ссылка на следующую песню
  end;


  // Типы для работы с типизированными файлами на диске
  TArtistFileRecord = record
    ArtistCode: Integer;
    Name: string[100];
    Country: string[50];
    Genre: string[30];
  end;

  TAlbumFileRecord = record
    AlbumCode: Integer;
    ArtistCode: Integer;
    Title: string[100];
    Year: Integer;
  end;

  TSongFileRecord = record
    Title: string[100];
    AlbumCode: Integer;
    Duration: Integer;
  end;

  // Типы типизированных файлов
  FArtists = file of TArtistFileRecord;
  FAlbums  = file of TAlbumFileRecord;
  FSongs   = file of TSongFileRecord;

  var
    // Глобальные указатели на начала списков
    HeadArtists: PArtist = nil;
    HeadAlbums: PAlbum = nil;
    HeadSongs: PSong = nil;

  procedure GenerateTestDataFiles;
  procedure ClearAllLists;
  procedure SortAlbumsByArtistAndYear;
  function IsArtistCodeExists(ACode: Integer): Boolean;
  function IsAlbumCodeExists(ACode: Integer): Boolean;

implementation

  // Процедура начальной генерации файлов artists.dat, albums.dat, songs.dat
  procedure GenerateTestDataFiles;
  var
    FileA: FArtists;
    FileAl: FAlbums;
    FileS: FSongs;
    RecArtist: TArtistFileRecord;
    RecAlbum: TAlbumFileRecord;
    RecSong: TSongFileRecord;
  begin
    // --- Генерация исполнителей ---
    AssignFile(FileA, 'artists.dat');
    Rewrite(FileA);

    RecArtist.ArtistCode := 1; RecArtist.Name := 'Deep Purple'; RecArtist.Country := 'UK'; RecArtist.Genre := 'rock';
    Write(FileA, RecArtist);
    RecArtist.ArtistCode := 2; RecArtist.Name := 'Miles Davis'; RecArtist.Country := 'USA'; RecArtist.Genre := 'jazz';
    Write(FileA, RecArtist);
    RecArtist.ArtistCode := 3; RecArtist.Name := 'The Weeknd'; RecArtist.Country := 'Canada'; RecArtist.Genre := 'pop';
    Write(FileA, RecArtist);

    CloseFile(FileA);

// --- ГЕНЕРАЦИЯ АЛЬБОМОВ ---
  AssignFile(FileAl, 'albums.dat');
  Rewrite(FileAl);

  // Исполнитель 1 (Deep Purple) - Альбом 1972 года
  RecAlbum.AlbumCode := 10; RecAlbum.ArtistCode := 1; RecAlbum.Title := 'Machine Head'; RecAlbum.Year := 1972;
  Write(FileAl, RecAlbum);

  // Исполнитель 2 (Miles Davis) - Альбом 1959 года
  RecAlbum.AlbumCode := 20; RecAlbum.ArtistCode := 2; RecAlbum.Title := 'Kind of Blue'; RecAlbum.Year := 1959;
  Write(FileAl, RecAlbum);

  // Исполнитель 1 (Deep Purple) - ДОБАВЛЯЕМ Альбом НАМЕРЕННО РАННЕГО 1970 года
  RecAlbum.AlbumCode := 11; RecAlbum.ArtistCode := 1; RecAlbum.Title := 'In Rock'; RecAlbum.Year := 1970;
  Write(FileAl, RecAlbum);

  // Исполнитель 3 (The Weeknd) - Альбом 2020 года
  RecAlbum.AlbumCode := 30; RecAlbum.ArtistCode := 3; RecAlbum.Title := 'After Hours'; RecAlbum.Year := 2020;
  Write(FileAl, RecAlbum);

  // Исполнитель 1 (Deep Purple) - ДОБАВЛЯЕМ Альбом БОЛЕЕ ПОЗДНЕГО 1984 года
  RecAlbum.AlbumCode := 12; RecAlbum.ArtistCode := 1; RecAlbum.Title := 'Perfect Strangers'; RecAlbum.Year := 1984;
  Write(FileAl, RecAlbum);

  // Исполнитель 2 (Miles Davis) - ДОБАВЛЯЕМ ВТОРОЙ АЛЬБОМ 1970 года
  RecAlbum.AlbumCode := 21; RecAlbum.ArtistCode := 2; RecAlbum.Title := 'Bitches Brew'; RecAlbum.Year := 1970;
  Write(FileAl, RecAlbum);

  CloseFile(FileAl);

  // Наполнение песен ---
  AssignFile(FileS, 'songs.dat');
  Rewrite(FileS);

  // Песни для Machine Head (10)
  RecSong.Title := 'Smoke on the Water'; RecSong.AlbumCode := 10; RecSong.Duration := 340; Write(FileS, RecSong);
  RecSong.Title := 'Highway Star';       RecSong.AlbumCode := 10; RecSong.Duration := 365; Write(FileS, RecSong);
  // Песня для In Rock (11)
  RecSong.Title := 'Child in Time';      RecSong.AlbumCode := 11; RecSong.Duration := 620; Write(FileS, RecSong);
  // Песня для Perfect Strangers (12)
  RecSong.Title := 'Perfect Strangers';  RecSong.AlbumCode := 12; RecSong.Duration := 323; Write(FileS, RecSong);

  // Песни для Kind of Blue (20)
  RecSong.Title := 'So What';             RecSong.AlbumCode := 20; RecSong.Duration := 562; Write(FileS, RecSong);
  // Песня для Bitches Brew (21)
  RecSong.Title := 'Pharaoh''s Dance';   RecSong.AlbumCode := 21; RecSong.Duration := 1204; Write(FileS, RecSong);

  // Песня для After Hours (30)
  RecSong.Title := 'Blinding Lights';    RecSong.AlbumCode := 30; RecSong.Duration := 200; Write(FileS, RecSong);
    CloseFile(FileS);
  end;

  // Процедура очистки памяти
  procedure ClearAllLists;
  var
    CurrArtist, NextArtist: PArtist;
    CurrAlbum, NextAlbum: PAlbum;
    CurrSong, NextSong: PSong;
  begin
    CurrArtist := HeadArtists;
    while CurrArtist <> nil do begin
      NextArtist := CurrArtist^.Next;
      Dispose(CurrArtist);
      CurrArtist := NextArtist;
    end;
    HeadArtists := nil;

    CurrAlbum := HeadAlbums;
    while CurrAlbum <> nil do begin
      NextAlbum := CurrAlbum^.Next;
      Dispose(CurrAlbum);
      CurrAlbum := NextAlbum;
    end;
    HeadAlbums := nil;

    CurrSong := HeadSongs;
    while CurrSong <> nil do begin
      NextSong := CurrSong^.Next;
      Dispose(CurrSong);
      CurrSong := NextSong;
    end;
    HeadSongs := nil;
  end;

  procedure SortAlbumsByArtistAndYear;
  var
    WasChanged: Boolean;
    Curr: PAlbum;
    // Переменные для обмена данными
    TempArtistCode, TempAlbumCode, TempYear: Integer;
    TempTitle: string;
  begin
    // Если список пуст или в нем всего один элемент, сортировать нечего
    if (HeadAlbums = nil) or (HeadAlbums^.Next = nil) then Exit;

    repeat
      WasChanged := False;
      Curr := HeadAlbums;

      while Curr^.Next <> nil do
      begin
        // Сразу группировка по коду исполнителя
        // Если исполнитель один и тот же, сортируется по году выпуска от старых к новым
        if (Curr^.ArtistCode > Curr^.Next^.ArtistCode) or
           ((Curr^.ArtistCode = Curr^.Next^.ArtistCode) and (Curr^.Year > Curr^.Next^.Year)) then
        begin
          // Меняются местами данные в узлах
          TempArtistCode := Curr^.ArtistCode;
          TempAlbumCode := Curr^.AlbumCode;
          TempTitle := Curr^.Title;
          TempYear := Curr^.Year;

          Curr^.ArtistCode := Curr^.Next^.ArtistCode;
          Curr^.AlbumCode := Curr^.Next^.AlbumCode;
          Curr^.Title := Curr^.Next^.Title;
          Curr^.Year := Curr^.Next^.Year;

          Curr^.Next^.ArtistCode := TempArtistCode;
          Curr^.Next^.AlbumCode := TempAlbumCode;
          Curr^.Next^.Title := TempTitle;
          Curr^.Next^.Year := TempYear;

          WasChanged := True; // Флаг перестановки
        end;

        Curr := Curr^.Next; // Переход к следующей паре
      end;
    until not WasChanged; // Повтор до полной сортировки
  end;

  function IsArtistCodeExists(ACode: Integer): Boolean;
  var Curr: PArtist;
  begin
    Result := False;
    Curr := HeadArtists;
    while Curr <> nil do begin
      if Curr^.ArtistCode = ACode then Exit(True);
      Curr := Curr^.Next;
    end;
  end;

  function IsAlbumCodeExists(ACode: Integer): Boolean;
  var Curr: PAlbum;
  begin
    Result := False;
    Curr := HeadAlbums;
    while Curr <> nil do begin
      if Curr^.AlbumCode = ACode then Exit(True);
      Curr := Curr^.Next;
    end;
  end;

end.
