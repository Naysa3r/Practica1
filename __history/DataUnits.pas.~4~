unit DataUnits;

interface

uses
  System.SysUtils;

type

// --- ИСПОЛНИТЕЛИ ---
  PArtist = ^TArtist; // Указатель на запись исполнителя
  TArtist = record
    ArtistCode: Integer;
    Name: string[100];
    Country: string[50];
    Genre: string[30];
    Next: PArtist; // Ссылка на следующего исполнителя в списке
  end;

  // --- АЛЬБОМЫ ---
  PAlbum = ^TAlbum; // Указатель на запись альбома
  TAlbum = record
    AlbumCode: Integer;
    ArtistCode: Integer; // Связь с исполнителем
    Title: string[100];
    Year: Integer;
    Next: PAlbum; // Ссылка на следующий альбом
  end;

  // --- ПЕСНИ ---
  PSong = ^TSong; // Указатель на запись песни
  TSong = record
    Title: string[100];
    AlbumCode: Integer; // Связь с альбомом
    Duration: Integer; // Длительность в секундах
    Next: PSong; // Ссылка на следующую песню
  end;


  // Типы для работы с типизированными файлами на диске
  TArtistFileRecord = record
    ArtistCode: Integer;
    Name: string[100];
    Country: string[50];
    Genre: string[30];
  end;

  TAlbumFileRecord = record
    AlbumCode: Integer;
    ArtistCode: Integer;
    Title: string[100];
    Year: Integer;
  end;

  TSongFileRecord = record
    Title: string[100];
    AlbumCode: Integer;
    Duration: Integer;
  end;

  // Типы типизированных файлов
  FArtists = file of TArtistFileRecord;
  FAlbums  = file of TAlbumFileRecord;
  FSongs   = file of TSongFileRecord;

  var
    // Глобальные указатели на начала списков
    HeadArtists: PArtist = nil;
    HeadAlbums: PAlbum = nil;
    HeadSongs: PSong = nil;

  procedure GenerateTestDataFiles;

implementation

  // Процедура начальной генерации файлов artists.dat, albums.dat, songs.dat
  procedure GenerateTestDataFiles;
  var
    FileA: FArtists;
    FileAl: FAlbums;
    FileS: FSongs;
    RecArtist: TArtistFileRecord;
    RecAlbum: TAlbumFileRecord;
    RecSong: TSongFileRecord;
  begin
    // --- Генерация исполнителей ---
    AssignFile(FileA, 'artists.dat');
    Rewrite(FileA);

    RecArtist.ArtistCode := 1; RecArtist.Name := 'Deep Purple'; RecArtist.Country := 'UK'; RecArtist.Genre := 'rock';
    Write(FileA, RecArtist);
    RecArtist.ArtistCode := 2; RecArtist.Name := 'Miles Davis'; RecArtist.Country := 'USA'; RecArtist.Genre := 'jazz';
    Write(FileA, RecArtist);
    RecArtist.ArtistCode := 3; RecArtist.Name := 'The Weeknd'; RecArtist.Country := 'Canada'; RecArtist.Genre := 'pop';
    Write(FileA, RecArtist);

    CloseFile(FileA);

    // --- Наполнение альбомов ---
    AssignFile(FileAl, 'albums.dat');
    Rewrite(FileAl);

    RecAlbum.AlbumCode := 10; RecAlbum.ArtistCode := 1; RecAlbum.Title := 'Machine Head'; RecAlbum.Year := 1972;
    Write(FileAl, RecAlbum);
    RecAlbum.AlbumCode := 20; RecAlbum.ArtistCode := 2; RecAlbum.Title := 'Kind of Blue'; RecAlbum.Year := 1959;
    Write(FileAl, RecAlbum);
    RecAlbum.AlbumCode := 30; RecAlbum.ArtistCode := 3; RecAlbum.Title := 'After Hours'; RecAlbum.Year := 2020;
    Write(FileAl, RecAlbum);

    CloseFile(FileAl);

    // --- Наполнение песен ---
    AssignFile(FileS, 'songs.dat');
    Rewrite(FileS);

    RecSong.Title := 'Smoke on the Water'; RecSong.AlbumCode := 10; RecSong.Duration := 340; Write(FileS, RecSong);
    RecSong.Title := 'Highway Star';       RecSong.AlbumCode := 10; RecSong.Duration := 365; Write(FileS, RecSong);
    RecSong.Title := 'So What';             RecSong.AlbumCode := 20; RecSong.Duration := 562; Write(FileS, RecSong);
    RecSong.Title := 'Blinding Lights';    RecSong.AlbumCode := 30; RecSong.Duration := 200; Write(FileS, RecSong);

    CloseFile(FileS);
  end;

end.
